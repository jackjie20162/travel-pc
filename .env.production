# travel-pc 生产构建覆盖配置（vite build 时优先级高于 .env）
#
# .env 里的 localhost 直连地址仅用于本地开发；生产环境：
# - API / 上传资源全部走同源相对路径，由 nginx 反代到集群内服务（见 deploy/nginx.conf）
# - IM 同样同源：置空下方变量后，代码按页面 origin 拼 wss(s)://<当前域名>/ws，
#   由 nginx /ws、/im 代理到 im-gateway:9281，无需独立 IM 域名

# 不指向其他 origin：留空 => src/api.js 使用相对路径 /api/*
VITE_TRAVEL_API_ORIGIN=

# 留空 => utils/media.js 对 /uploads/* 保持相对路径，由同源 nginx 代理
VITE_UPLOAD_BASE_URL=

# 本地测试数据在 tenant=2 / merchant=1（商户端 shopId=2 创建）；上线按实际租户/商户修改
VITE_TRAVEL_TENANT_ID=2
VITE_TRAVEL_MERCHANT_ID=1

# IM 网关：置空以覆盖 .env 中的开发直连地址，生产走同源 /ws、/im 代理；
# 确需指向独立域名时再填写绝对地址
VITE_IM_WS_URL=
VITE_IM_API_URL=
